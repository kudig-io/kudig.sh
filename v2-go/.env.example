# kudig 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# === AI 配置 ===
# AI 提供商: openai, qwen, ollama
KUDIG_AI_PROVIDER=openai
# API Key (必填，除非使用 Ollama)
KUDIG_AI_API_KEY=sk-your-api-key-here
# 自定义 API 端点 (Ollama: http://localhost:11434/v1)
# KUDIG_AI_BASE_URL=
# 模型名称
KUDIG_AI_MODEL=gpt-4
# API 超时 (秒)
KUDIG_AI_TIMEOUT=30
# 输出语言: zh (中文) 或 en (英文)
KUDIG_AI_LANGUAGE=zh
# 最大 token 数
KUDIG_AI_MAX_TOKENS=2000
# 温度 (0.0-1.0)
KUDIG_AI_TEMPERATURE=0.3

# === 通知配置 ===
# Webhook URL (支持飞书/钉钉/企业微信/Slack)
# KUDIG_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 通知级别阈值: critical, warning, info
# KUDIG_NOTIFY_LEVEL=warning

# === Kubernetes 配置 ===
# kubeconfig 路径 (默认: ~/.kube/config)
# KUBECONFIG=/path/to/kubeconfig
# 运行在集群内时，通过 NODE_NAME 指定当前节点
# NODE_NAME=k8s-node-01
